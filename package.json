{
  "name": "iua-connect",
  "private": true,
  "description": "IUA Connect: the digital home of Israeli urology (private pitch app, demo data only)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "setup:dev": "node tools/scripts/setup-dev.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint --max-warnings=0 tools",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:provision": "node tools/scripts/db-provision.mjs",
    "db:migrate": "pnpm --filter @iua/api db:migrate",
    "db:deploy": "pnpm --filter @iua/api db:deploy",
    "db:reset": "pnpm --filter @iua/api db:reset",
    "db:seed": "pnpm --filter @iua/api db:seed",
    "openapi:generate": "turbo run build --filter=@iua/api && pnpm --filter @iua/api openapi:export && pnpm --filter @iua/api-client generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@iua/eslint-config": "workspace:*",
    "dotenv": "18.0.4",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3"
  }
}
