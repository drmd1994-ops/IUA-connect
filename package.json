{
  "name": "med-connect",
  "private": true,
  "description": "Med Connect: the digital home of Israeli urology (private pitch app, demo data only)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "setup:dev": "node tools/scripts/setup-dev.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint --max-warnings=0 tools",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:provision": "node tools/scripts/db-provision.mjs",
    "db:migrate": "pnpm --filter @medconnect/api db:migrate",
    "db:deploy": "pnpm --filter @medconnect/api db:deploy",
    "db:reset": "pnpm --filter @medconnect/api db:reset",
    "db:seed": "pnpm --filter @medconnect/api db:seed",
    "admin:create": "pnpm --filter @medconnect/api admin:create",
    "import:fetch": "pnpm --filter @medconnect/importer run pages",
    "import:remove": "pnpm --filter @medconnect/api import:remove",
    "job:run": "pnpm --filter @medconnect/api job:run",
    "demo:reset": "pnpm --filter @medconnect/api demo:reset",
    "openapi:generate": "turbo run build --filter=@medconnect/api && pnpm --filter @medconnect/api openapi:export && pnpm --filter @medconnect/api-client generate",
    "prepare": "husky",
    "hosted:start": "node tools/scripts/hosted-start.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@medconnect/eslint-config": "workspace:*",
    "@types/node": "24.13.6",
    "dotenv": "18.0.1",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  }
}
