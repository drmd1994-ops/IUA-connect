{
  "name": "@iua/web",
  "version": "0.0.0",
  "private": true,
  "description": "IUA Connect web app: public site, member area and /admin route group (Next.js)",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 src e2e playwright.config.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "@iua/api-client": "workspace:*",
    "@iua/i18n": "workspace:*",
    "@iua/shared": "workspace:*",
    "@iua/ui-tokens": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iua/eslint-config": "workspace:*",
    "@iua/tsconfig": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "otpauth": "9.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
