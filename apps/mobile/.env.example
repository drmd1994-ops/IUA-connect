# Where the app finds the server. In the demo: this computer's address on the Wi-Fi the phone
# is on (see "ipconfig", IPv4 Address), with the API's port. Copy this file to ".env".
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# The website, for the links the app opens in the browser (forgot password, joining).
EXPO_PUBLIC_WEB_URL=http://192.168.1.20:3001
# React Native's own fetch, which can send a picked file (see .github/workflows/apk.yml).
EXPO_PUBLIC_USE_RN_FETCH=1
