{
  "expo": {
    "name": "Med Connect",
    "slug": "med-connect",
    "scheme": "medconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "platforms": ["android", "ios"],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#134d67"
      },
      "package": "test.demo.medconnect"
    },
    "ios": {
      "bundleIdentifier": "test.demo.medconnect"
    },
    "extra": {
      "supportsRTL": true
    },
    "plugins": [
      "expo-router",
      "./plugins/with-release-signing",
      "./plugins/with-app-links",
      "./plugins/with-secure-screen",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Med Connect to use Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Med Connect to use the camera to read a code, and to take a picture you send in chat.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Med Connect to open the pictures and videos you choose to send.",
          "cameraPermission": "Allow Med Connect to use the camera to take a picture you send in chat.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
