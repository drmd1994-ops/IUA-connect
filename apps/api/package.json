{
  "name": "@medconnect/api",
  "version": "0.0.0",
  "private": true,
  "description": "Med Connect API (NestJS modular monolith)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src test prisma",
    "test": "prisma generate && jest",
    "test:integration": "prisma generate && jest -c test/jest-integration.config.js --maxWorkers=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "admin:create": "tsx prisma/scripts/create-admin.ts",
    "import:remove": "tsx prisma/scripts/remove-import.ts",
    "job:run": "pnpm run build && node dist/job-run.js",
    "demo:reset": "tsx prisma/scripts/demo-reset.ts",
    "openapi:export": "node dist/openapi-export.js ../../packages/api-client/openapi.json"
  },
  "dependencies": {
    "@medconnect/i18n": "workspace:*",
    "@medconnect/shared": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "14.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.1",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.0",
    "nestjs-zod": "5.5.0",
    "otpauth": "9.5.2",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@medconnect/eslint-config": "workspace:*",
    "@medconnect/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
