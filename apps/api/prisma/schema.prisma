// IUA Connect database schema. Design and conventions: DATABASE_DESIGN.md.
// - Primary keys are UUID v7, generated in the application (@iua/shared uuidv7).
// - snake_case in the database via @map / @@map.
// - Extensions, SQL functions, triggers and grants live in raw SQL inside the migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Append-only audit trail (SECURITY_MODEL.md §3). UPDATE, DELETE and TRUNCATE are rejected by
/// triggers, and the application role only holds SELECT and INSERT on this table.
/// actor_user_id deliberately has no foreign key: accounts are hard-deleted after the grace
/// period while their audit rows keep the pseudonymous ID (DATABASE_DESIGN.md §7), and the
/// append-only trigger forbids the ON DELETE SET NULL a foreign key would need.
model AuditLog {
  id            String   @id @db.Uuid
  at            DateTime @default(now()) @db.Timestamptz(6)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorIp       String?  @map("actor_ip") @db.Inet
  action        String   @db.VarChar(100)
  entityType    String?  @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.VarChar(100)
  /// Redacted before insert. Never contains secrets or certificate numbers.
  changes       Json?
  correlationId String   @map("correlation_id") @db.VarChar(64)

  @@index([entityType, entityId, at(sort: Desc)])
  @@index([actorUserId, at(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Identity and access (M1). DATABASE_DESIGN.md §3 "Identity and access".
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  /// Locked by an administrator. Automatic lockouts after failed sign-ins use users.locked_until.
  LOCKED
  DISABLED

  @@map("user_status")
}

model User {
  id               String     @id @db.Uuid
  email            String     @unique @db.Citext
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash     String     @map("password_hash")
  status           UserStatus @default(ACTIVE)
  /// Consecutive failed sign-ins since the last success or lock.
  failedLoginCount Int        @default(0) @map("failed_login_count")
  /// Number of automatic lockouts since the last successful sign-in (drives the backoff).
  lockoutCount     Int        @default(0) @map("lockout_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  locale           String     @default("he") @db.VarChar(8)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles         UserRole[]     @relation("UserRoles")
  rolesGranted  UserRole[]     @relation("RolesGrantedBy")
  sessions      Session[]
  devices       Device[]
  mfaFactors    MfaFactor[]
  recoveryCodes RecoveryCode[]
  authTokens    AuthToken[]
  profile       Profile?

  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  key         String   @unique @db.VarChar(64)
  /// i18n key for the display name, e.g. "roles.SUPER_ADMIN".
  nameKey     String   @map("name_key") @db.VarChar(100)
  requiresMfa Boolean  @default(true) @map("requires_mfa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @db.Uuid
  key       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum RoleScopeType {
  NONE
  DEPARTMENT
  SUBSPECIALTY

  @@map("role_scope_type")
}

/// A role granted to a user, optionally scoped (e.g. DEPARTMENT_DIRECTOR of one department).
/// scope_id gets its foreign key when departments/subspecialties exist (M2).
model UserRole {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  roleId    String        @map("role_id") @db.Uuid
  scopeType RoleScopeType @default(NONE) @map("scope_type")
  scopeId   String?       @map("scope_id") @db.Uuid
  grantedBy String?       @map("granted_by") @db.Uuid
  grantedAt DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)

  user          User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User? @relation("RolesGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  /// Uniqueness treats NULL scope_id as equal (NULLS NOT DISTINCT), set in the migration.
  @@unique([userId, roleId, scopeType, scopeId])
  @@map("user_roles")
}

/// A browser or app instance, identified by a random device cookie (only its hash is stored).
model Device {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.VarChar(128)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@map("devices")
}

model Session {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceId          String?   @map("device_id") @db.Uuid
  ip                String?   @db.Inet
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  /// Set when MFA was completed in this session (TOTP challenge, or MFA enrolment).
  mfaCompletedAt    DateTime? @map("mfa_completed_at") @db.Timestamptz(6)
  /// Last time the user re-entered their password (and code) in this session.
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Idle limit in seconds, fixed when the session is created (shorter for admin roles).
  idleTimeoutSec    Int       @map("idle_timeout_sec")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens. Only a keyed hash is stored. All tokens of a session form one family:
/// presenting an already-used token revokes the session (reuse detection).
model RefreshToken {
  id         String    @id @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

enum MfaFactorType {
  TOTP
  WEBAUTHN

  @@map("mfa_factor_type")
}

model MfaFactor {
  id                  String        @id @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  type                MfaFactorType
  /// AES-256-GCM ciphertext with key ID (TOTP only).
  secretEncrypted     String?       @map("secret_encrypted")
  /// WebAuthn (passkey, M1b): COSE public key. The private key never leaves the device.
  credentialPublicKey Bytes?        @map("credential_public_key")
  /// WebAuthn credential ID, as returned by the authenticator.
  credentialId        Bytes?        @unique @map("credential_id")
  /// WebAuthn signature counter (0 for authenticators that don't count, e.g. synced passkeys).
  signCount           BigInt        @default(0) @map("sign_count")
  /// How the browser can reach the authenticator: internal, hybrid, usb, nfc, ble.
  transports          String[]      @default([])
  /// Synced passkey (iCloud Keychain, Google Password Manager, ...) rather than device-bound.
  backedUp            Boolean?      @map("backed_up")
  /// Passkey name chosen by the user; "Authenticator app" for TOTP.
  label               String?       @db.VarChar(100)
  /// Null until the user proves possession with a first valid code.
  confirmedAt         DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  /// Highest TOTP time-step accepted so far; codes at or below it are replays.
  lastUsedStep        BigInt?       @map("last_used_step")
  lastUsedAt          DateTime?     @map("last_used_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

model RecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// Issued after a correct password when MFA is enabled; exchanged for a session with a code.
  MFA_CHALLENGE
  /// Passkey registration challenge (M1b).
  WEBAUTHN_REGISTRATION
  /// Passkey sign-in challenge (M1b). Issued before the user is known, so it has no user.
  WEBAUTHN_AUTHENTICATION

  @@map("auth_token_purpose")
}

/// Single-use, expiring tokens sent by email or used between sign-in steps. Only a keyed hash is stored.
/// user_id is required for every purpose except WEBAUTHN_AUTHENTICATION (check constraint).
model AuthToken {
  id        String           @id @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.VarChar(128)
  /// Failed attempts against this token (MFA challenge).
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// People and institutions (M2). DATABASE_DESIGN.md §3 "People and institutions".
// Lookup tables admins can edit. Rows are deactivated, never deleted, once referenced.
// ---------------------------------------------------------------------------

model Hospital {
  id        String   @id @db.Uuid
  /// Stable key the reference seed matches on (e.g. "rambam"); admin-created rows get a generated one.
  code      String   @unique @db.VarChar(64)
  nameHe    String   @map("name_he") @db.VarChar(200)
  nameEn    String   @map("name_en") @db.VarChar(200)
  cityHe    String   @map("city_he") @db.VarChar(100)
  cityEn    String   @map("city_en") @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments Department[]
  profiles    Profile[]

  @@map("hospitals")
}

/// A hospital department. Its directors are DEPARTMENT_DIRECTOR grants scoped to it (user_roles).
model Department {
  id         String   @id @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  /// Stable key within the hospital (e.g. "urology").
  code       String   @db.VarChar(64)
  nameHe     String   @map("name_he") @db.VarChar(200)
  nameEn     String   @map("name_en") @db.VarChar(200)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  hospital Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  profiles Profile[]

  @@unique([hospitalId, code])
  @@map("departments")
}

model Subspecialty {
  id        String   @id @db.Uuid
  key       String   @unique @db.VarChar(64)
  nameHe    String   @map("name_he") @db.VarChar(200)
  nameEn    String   @map("name_en") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profiles ProfileSubspecialty[]

  @@map("subspecialties")
}

/// What an applicant proves when applying for a membership type (M2 plan §2, §11).
enum MembershipIdentifier {
  NONE
  SPECIALIST_CERTIFICATE
  MEDICAL_LICENCE

  @@map("membership_identifier")
}

/// FULL_MEMBER, NON_FULL_MEMBER, RESIDENT, STUDENT, HONORARY_MEMBER (ADR 0004).
model MembershipType {
  id               String               @id @db.Uuid
  key              String               @unique @db.VarChar(64)
  nameHe           String               @map("name_he") @db.VarChar(200)
  nameEn           String               @map("name_en") @db.VarChar(200)
  identifier       MembershipIdentifier @default(NONE)
  /// Members can apply for it themselves (HONORARY_MEMBER is granted by admins only).
  selfApply        Boolean              @default(true) @map("self_apply")
  /// Applications go to the department director before the IUA admin (students skip it).
  directorApproval Boolean              @default(true) @map("director_approval")
  /// Informational until payments exist (D4).
  annualFee        Decimal?             @map("annual_fee") @db.Decimal(12, 2)
  currency         String?              @db.Char(3)
  sortOrder        Int                  @default(0) @map("sort_order")
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("membership_types")
}

/// A member's professional profile (spec §6). Photo arrives with the Files module (M3),
/// publications with Phase 2. Who may see each field is in profile_field_visibility.
model Profile {
  userId            String   @id @map("user_id") @db.Uuid
  firstName         String?  @map("first_name") @db.VarChar(100)
  lastName          String?  @map("last_name") @db.VarChar(100)
  nameHe            String?  @map("name_he") @db.VarChar(200)
  nameEn            String?  @map("name_en") @db.VarChar(200)
  title             String?  @db.VarChar(100)
  position          String?  @db.VarChar(200)
  hospitalId        String?  @map("hospital_id") @db.Uuid
  departmentId      String?  @map("department_id") @db.Uuid
  bio               String?
  researchInterests String?  @map("research_interests")
  orcid             String?  @db.VarChar(19)
  /// ISO 639 language codes; clients show the names in the reader's locale.
  languages         String[] @default([])
  contactEmail      String?  @map("contact_email") @db.Citext
  contactPhone      String?  @map("contact_phone") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital       Hospital?                @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department     Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subspecialties ProfileSubspecialty[]
  visibility     ProfileFieldVisibility[]

  @@index([departmentId])
  @@map("profiles")
}

model ProfileSubspecialty {
  userId         String @map("user_id") @db.Uuid
  subspecialtyId String @map("subspecialty_id") @db.Uuid

  profile      Profile      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  subspecialty Subspecialty @relation(fields: [subspecialtyId], references: [id], onDelete: Restrict)

  @@id([userId, subspecialtyId])
  @@map("profile_subspecialties")
}

/// Profile fields with their own visibility (D9). First and last name share NAME.
enum ProfileField {
  NAME
  NAME_HE
  NAME_EN
  TITLE
  POSITION
  INSTITUTION
  SUBSPECIALTIES
  BIO
  RESEARCH_INTERESTS
  ORCID
  LANGUAGES
  CONTACT_EMAIL
  CONTACT_PHONE

  @@map("profile_field")
}

enum Visibility {
  PRIVATE
  MEMBERS
  PUBLIC

  @@map("visibility")
}

/// A missing row means PRIVATE (the default, PRODUCT_REQUIREMENTS §3.2).
model ProfileFieldVisibility {
  userId     String       @map("user_id") @db.Uuid
  field      ProfileField
  visibility Visibility

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, field])
  @@map("profile_field_visibility")
}
