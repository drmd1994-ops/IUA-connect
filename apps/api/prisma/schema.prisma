// Med Connect database schema. Design and conventions: DATABASE_DESIGN.md.
// - Primary keys are UUID v7, generated in the application (@medconnect/shared uuidv7).
// - snake_case in the database via @map / @@map.
// - Extensions, SQL functions, triggers, grants, CHECK constraints, partial indexes and composite
//   foreign keys live in raw SQL inside the migrations. Prisma does not model some of them, so a
//   generated migration may try to drop them: remove those DROP statements before applying.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Append-only audit trail (SECURITY_MODEL.md §3). UPDATE, DELETE and TRUNCATE are rejected by
/// triggers, and the application role only holds SELECT and INSERT on this table.
/// actor_user_id deliberately has no foreign key: accounts are hard-deleted after the grace
/// period while their audit rows keep the pseudonymous ID (DATABASE_DESIGN.md §7), and the
/// append-only trigger forbids the ON DELETE SET NULL a foreign key would need.
model AuditLog {
  id            String   @id @db.Uuid
  at            DateTime @default(now()) @db.Timestamptz(6)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorIp       String?  @map("actor_ip") @db.Inet
  action        String   @db.VarChar(100)
  entityType    String?  @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.VarChar(100)
  /// Redacted before insert. Never contains secrets or certificate numbers.
  changes       Json?
  correlationId String   @map("correlation_id") @db.VarChar(64)

  @@index([entityType, entityId, at(sort: Desc)])
  @@index([actorUserId, at(sort: Desc)])
  /// The admin's audit log page: newest first, with or without filters.
  @@index([at(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Identity and access (M1). DATABASE_DESIGN.md §3 "Identity and access".
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  /// Locked by an administrator. Automatic lockouts after failed sign-ins use users.locked_until.
  LOCKED
  DISABLED

  @@map("user_status")
}

model User {
  id               String      @id @db.Uuid
  email            String      @unique @db.Citext
  emailVerifiedAt  DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  passwordHash     String      @map("password_hash")
  status           UserStatus  @default(ACTIVE)
  /// Consecutive failed sign-ins since the last success or lock.
  failedLoginCount Int         @default(0) @map("failed_login_count")
  /// Number of automatic lockouts since the last successful sign-in (drives the backoff).
  lockoutCount     Int         @default(0) @map("lockout_count")
  lockedUntil      DateTime?   @map("locked_until") @db.Timestamptz(6)
  locale           String      @default("he") @db.VarChar(8)
  lastLoginAt      DateTime?   @map("last_login_at") @db.Timestamptz(6)
  /// Known to the platform as a physician since then (M16). Empty: not verified.
  verifiedAt       DateTime?   @map("verified_at") @db.Timestamptz(6)
  /// What the platform knows the person as, while verified (M17). Empty: not verified.
  verifiedAs       VerifiedAs? @map("verified_as")
  /// When the verification is looked at again (M17): a student's expected graduation, or the
  /// platform's re-check date. Empty: no end (an organisation vouches for the person).
  verifiedUntil    DateTime?   @map("verified_until") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]               @relation("UserRoles")
  rolesGranted        UserRole[]               @relation("RolesGrantedBy")
  sessions            Session[]
  devices             Device[]
  mfaFactors          MfaFactor[]
  recoveryCodes       RecoveryCode[]
  authTokens          AuthToken[]
  profile             Profile?
  memberships         Membership[]
  applications        VerificationRequest[]
  physicianChecks     PhysicianVerification[]
  invitationsSent     PlatformInvitation[]     @relation("InvitationsSent")
  files               StoredFile[]
  newsAuthored        News[]
  eventRegistrations  EventRegistration[]
  scheduleItems       ScheduleItem[]
  eventAttendances    EventAttendance[]
  eventReminders      EventReminder[]
  examAnswers         ExamAnswer[]
  mockExams           MockExam[]
  examBookmarks       ExamBookmark[]
  examReports         ExamReport[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  announcementReads   AnnouncementRead[]
  notificationState   NotificationState?
  broadcastDeliveries BroadcastDelivery[]
  consents            Consent[]
  conversationsLow    Conversation[]           @relation("ConversationUserLow")
  conversationsHigh   Conversation[]           @relation("ConversationUserHigh")
  conversationMembers ConversationMember[]
  messages            Message[]
  messageHides        MessageHide[]
  chatInvitations     ConversationInvitation[] @relation("ChatInvited")
  chatInvitationsMade ConversationInvitation[] @relation("ChatInviter")
  chatBlocksMade      ChatBlock[]              @relation("ChatBlocker")
  chatBlocksReceived  ChatBlock[]              @relation("ChatBlocked")
  chatPreference      ChatPreference?
  chatReportsMade     ChatReport[]             @relation("ChatReporter")
  chatReportsReceived ChatReport[]             @relation("ChatReported")
  chatSuspensions     ChatSuspension[]
  messageReactions    MessageReaction[]
  conversationBans    ConversationBan[]

  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  key         String   @unique @db.VarChar(64)
  /// i18n key for the display name, e.g. "roles.SUPER_ADMIN".
  nameKey     String   @map("name_key") @db.VarChar(100)
  requiresMfa Boolean  @default(true) @map("requires_mfa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @db.Uuid
  key       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum RoleScopeType {
  NONE
  DEPARTMENT
  SUBSPECIALTY

  @@map("role_scope_type")
}

/// A role granted to a user, optionally scoped (e.g. DEPARTMENT_DIRECTOR of one department).
/// scope_id gets its foreign key when departments/subspecialties exist (M2).
model UserRole {
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  scopeType      RoleScopeType @default(NONE) @map("scope_type")
  scopeId        String?       @map("scope_id") @db.Uuid
  /// The organisation the role is held in. Empty: held on the platform. (M16)
  organisationId String?       @map("organisation_id") @db.Uuid
  grantedBy      String?       @map("granted_by") @db.Uuid
  grantedAt      DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)

  user          User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User? @relation("RolesGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  /// Uniqueness treats NULL scope_id as equal (NULLS NOT DISTINCT), set in the migration.
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId, organisationId])
  @@index([organisationId])
  @@map("user_roles")
}

/// A browser or app instance, identified by a random device cookie (only its hash is stored).
model Device {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.VarChar(128)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@map("devices")
}

/// What started a session: a browser, which keeps the refresh token in a cookie, or the mobile
/// app, which keeps it in the phone's secure storage (M14).
enum SessionClient {
  WEB
  APP

  @@map("session_client")
}

model Session {
  id                String        @id @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  deviceId          String?       @map("device_id") @db.Uuid
  ip                String?       @db.Inet
  userAgent         String?       @map("user_agent") @db.VarChar(512)
  /// Set when MFA was completed in this session (TOTP challenge, or MFA enrolment).
  mfaCompletedAt    DateTime?     @map("mfa_completed_at") @db.Timestamptz(6)
  /// Last time the user re-entered their password (and code) in this session.
  reauthenticatedAt DateTime?     @map("reauthenticated_at") @db.Timestamptz(6)
  lastSeenAt        DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Idle limit in seconds, fixed when the session is created (shorter for admin roles).
  idleTimeoutSec    Int           @map("idle_timeout_sec")
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?       @map("revoked_reason") @db.VarChar(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// A session's refresh token is accepted only the way its client presents it (M14).
  client            SessionClient @default(WEB)
  /// What the app called the phone ("Pixel 9 of Noa"), shown in "my sessions".
  clientName        String?       @map("client_name") @db.VarChar(80)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens. Only a keyed hash is stored. All tokens of a session form one family:
/// presenting an already-used token revokes the session (reuse detection).
model RefreshToken {
  id         String    @id @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

enum MfaFactorType {
  TOTP
  WEBAUTHN

  @@map("mfa_factor_type")
}

model MfaFactor {
  id                  String        @id @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  type                MfaFactorType
  /// AES-256-GCM ciphertext with key ID (TOTP only).
  secretEncrypted     String?       @map("secret_encrypted")
  /// WebAuthn (passkey, M1b): COSE public key. The private key never leaves the device.
  credentialPublicKey Bytes?        @map("credential_public_key")
  /// WebAuthn credential ID, as returned by the authenticator.
  credentialId        Bytes?        @unique @map("credential_id")
  /// WebAuthn signature counter (0 for authenticators that don't count, e.g. synced passkeys).
  signCount           BigInt        @default(0) @map("sign_count")
  /// How the browser can reach the authenticator: internal, hybrid, usb, nfc, ble.
  transports          String[]      @default([])
  /// Synced passkey (iCloud Keychain, Google Password Manager, ...) rather than device-bound.
  backedUp            Boolean?      @map("backed_up")
  /// Passkey name chosen by the user; "Authenticator app" for TOTP.
  label               String?       @db.VarChar(100)
  /// Null until the user proves possession with a first valid code.
  confirmedAt         DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  /// Highest TOTP time-step accepted so far; codes at or below it are replays.
  lastUsedStep        BigInt?       @map("last_used_step")
  lastUsedAt          DateTime?     @map("last_used_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

model RecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// "Set your password" link for accounts a membership import created (M2). 7 days.
  ACCOUNT_SETUP
  /// Issued after a correct password when MFA is enabled; exchanged for a session with a code.
  MFA_CHALLENGE
  /// Passkey registration challenge (M1b).
  WEBAUTHN_REGISTRATION
  /// Passkey sign-in challenge (M1b). Issued before the user is known, so it has no user.
  WEBAUTHN_AUTHENTICATION

  @@map("auth_token_purpose")
}

/// Single-use, expiring tokens sent by email or used between sign-in steps. Only a keyed hash is stored.
/// user_id is required for every purpose except WEBAUTHN_AUTHENTICATION (check constraint).
model AuthToken {
  id        String           @id @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.VarChar(128)
  /// Failed attempts against this token (MFA challenge).
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// People and institutions (M2). DATABASE_DESIGN.md §3 "People and institutions".
// Lookup tables admins can edit. Rows are deactivated, never deleted, once referenced.
// ---------------------------------------------------------------------------

model Hospital {
  id        String   @id @db.Uuid
  /// Stable key the reference seed matches on (e.g. "rambam"); admin-created rows get a generated one.
  code      String   @unique @db.VarChar(64)
  nameHe    String   @map("name_he") @db.VarChar(200)
  nameEn    String   @map("name_en") @db.VarChar(200)
  cityHe    String   @map("city_he") @db.VarChar(100)
  cityEn    String   @map("city_en") @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments  Department[]
  profiles     Profile[]
  applications VerificationRequest[]

  @@map("hospitals")
}

/// A hospital department. Its directors are DEPARTMENT_DIRECTOR grants scoped to it (user_roles).
model Department {
  id         String   @id @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  /// Stable key within the hospital (e.g. "urology").
  code       String   @db.VarChar(64)
  nameHe     String   @map("name_he") @db.VarChar(200)
  nameEn     String   @map("name_en") @db.VarChar(200)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  hospital     Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  profiles     Profile[]
  applications VerificationRequest[]

  @@unique([hospitalId, code])
  /// Target of the composite foreign keys that keep a profile's or application's department
  /// inside its hospital (raw SQL in the migrations).
  @@unique([id, hospitalId], map: "departments_id_hospital_id_key")
  @@map("departments")
}

model Subspecialty {
  id        String   @id @db.Uuid
  key       String   @unique @db.VarChar(64)
  nameHe    String   @map("name_he") @db.VarChar(200)
  nameEn    String   @map("name_en") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profiles      ProfileSubspecialty[]
  guidelines    Guideline[]
  education     EducationItem[]
  examQuestions ExamQuestion[]

  @@map("subspecialties")
}

/// What an applicant proves when applying for a membership type (M2 plan §2, §11).
enum MembershipIdentifier {
  NONE
  SPECIALIST_CERTIFICATE
  MEDICAL_LICENCE

  @@map("membership_identifier")
}

/// FULL_MEMBER, NON_FULL_MEMBER, RESIDENT, STUDENT, HONORARY_MEMBER (ADR 0004).
/// An organisation that has a section of its own on the platform (M16): its members, their
/// membership and card, its news, events, rooms and messages. The platform stands without any.
model Organisation {
  id            String   @id @db.Uuid
  /// In addresses. Lower-case letters, digits and dashes.
  slug          String   @unique @db.VarChar(64)
  nameHe        String   @map("name_he") @db.VarChar(200)
  nameEn        String   @map("name_en") @db.VarChar(200)
  descriptionHe String?  @map("description_he")
  descriptionEn String?  @map("description_en")
  /// An organisation that is not active keeps its data and shows nowhere.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membershipTypes MembershipType[]
  memberships     Membership[]
  news            News[]
  events          Event[]
  broadcasts      Broadcast[]
  rooms           Conversation[]
  speakers        Speaker[]
  staff           UserRole[]
  importBatches   ImportBatch[]
  applications    VerificationRequest[]

  @@map("organisations")
}

model MembershipType {
  id               String               @id @db.Uuid
  /// Whose it is. Every one belongs to an organisation. (M16)
  organisationId   String               @map("organisation_id") @db.Uuid
  key              String               @db.VarChar(64)
  nameHe           String               @map("name_he") @db.VarChar(200)
  nameEn           String               @map("name_en") @db.VarChar(200)
  identifier       MembershipIdentifier @default(NONE)
  /// Members can apply for it themselves (HONORARY_MEMBER is granted by admins only).
  selfApply        Boolean              @default(true) @map("self_apply")
  /// Applications go to the department director before the organisation’s admin (students skip it).
  directorApproval Boolean              @default(true) @map("director_approval")
  /// Informational until payments exist (D4).
  annualFee        Decimal?             @map("annual_fee") @db.Decimal(12, 2)
  currency         String?              @db.Char(3)
  sortOrder        Int                  @default(0) @map("sort_order")
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  applications VerificationRequest[]
  accessRules  ContentAccessRule[]

  @@unique([organisationId, key])
  @@map("membership_types")
}

/// A member's professional profile (spec §6). Photo arrives with the Files module (M3),
/// publications with Phase 2. Who may see each field is in profile_field_visibility.
model Profile {
  userId            String   @id @map("user_id") @db.Uuid
  firstName         String?  @map("first_name") @db.VarChar(100)
  lastName          String?  @map("last_name") @db.VarChar(100)
  nameHe            String?  @map("name_he") @db.VarChar(200)
  nameEn            String?  @map("name_en") @db.VarChar(200)
  title             String?  @db.VarChar(100)
  position          String?  @db.VarChar(200)
  hospitalId        String?  @map("hospital_id") @db.Uuid
  departmentId      String?  @map("department_id") @db.Uuid
  bio               String?
  researchInterests String?  @map("research_interests")
  orcid             String?  @db.VarChar(19)
  /// ISO 639 language codes; clients show the names in the reader's locale.
  languages         String[] @default([])
  contactEmail      String?  @map("contact_email") @db.Citext
  contactPhone      String?  @map("contact_phone") @db.VarChar(32)
  /// Profile photo (M3): an image file the member uploaded.
  photoFileId       String?  @unique @map("photo_file_id") @db.Uuid
  /// Listed in the member directory (D9). Off until the member switches it on; the consent is
  /// recorded in consents.
  directoryOptIn    Boolean  @default(false) @map("directory_opt_in")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo          StoredFile?              @relation("ProfilePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  hospital       Hospital?                @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department     Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subspecialties ProfileSubspecialty[]
  visibility     ProfileFieldVisibility[]

  @@index([departmentId])
  @@map("profiles")
}

model ProfileSubspecialty {
  userId         String @map("user_id") @db.Uuid
  subspecialtyId String @map("subspecialty_id") @db.Uuid

  profile      Profile      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  subspecialty Subspecialty @relation(fields: [subspecialtyId], references: [id], onDelete: Restrict)

  @@id([userId, subspecialtyId])
  @@map("profile_subspecialties")
}

/// Profile fields with their own visibility (D9). First and last name share NAME.
enum ProfileField {
  NAME
  NAME_HE
  NAME_EN
  TITLE
  POSITION
  INSTITUTION
  SUBSPECIALTIES
  BIO
  RESEARCH_INTERESTS
  ORCID
  LANGUAGES
  CONTACT_EMAIL
  CONTACT_PHONE
  /// Profile photo (M3).
  PHOTO

  @@map("profile_field")
}

enum Visibility {
  PRIVATE
  MEMBERS
  PUBLIC

  @@map("visibility")
}

/// A missing row means PRIVATE (the default, PRODUCT_REQUIREMENTS §3.2).
model ProfileFieldVisibility {
  userId     String       @map("user_id") @db.Uuid
  field      ProfileField
  visibility Visibility

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, field])
  @@map("profile_field_visibility")
}

// ---------------------------------------------------------------------------
// Membership and verification (M2). DATABASE_DESIGN.md §3 "Membership and verification".
// ---------------------------------------------------------------------------

/// Stored status. "Expired" is never stored: it is computed from end_date (DATABASE_DESIGN §1).
enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum PaymentStatus {
  NOT_REQUIRED
  UNPAID
  PAID
  WAIVED

  @@map("payment_status")
}

enum MembershipSource {
  MANUAL
  IMPORT
  IMA

  @@map("membership_source")
}

/// A member's current membership (one per user). Renewals extend it; every change is in
/// membership_history. Periods run by calendar year and end on 31 December (owner, 2026-09-29).
model Membership {
  id             String           @id @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// Whose it is. Every one belongs to an organisation. (M16)
  organisationId String           @map("organisation_id") @db.Uuid
  typeId         String           @map("type_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  paymentStatus  PaymentStatus    @default(NOT_REQUIRED) @map("payment_status")
  source         MembershipSource @default(MANUAL)
  /// Specialist certificate or medical licence number: AES-256-GCM ciphertext. Never shown or logged.
  identifierEnc  String?          @map("identifier_enc")
  /// Keyed hash of the same number, so one number can't hold two memberships.
  identifierHash String?          @map("identifier_hash") @db.VarChar(128)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         MembershipType      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  history      MembershipHistory[]
  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  /// One membership in an organisation; a person may belong to several organisations.
  @@unique([userId, organisationId])
  /// A licence or certificate number is one person's within an organisation.
  @@unique([organisationId, identifierHash])
  @@index([status, endDate])
  @@map("memberships")
}

enum MembershipEvent {
  CREATED
  RENEWED
  SUSPENDED
  REINSTATED
  EXPIRED
  TYPE_CHANGED
  PAYMENT_STATUS_CHANGED
  /// Created or changed by a CSV import (details: batch, type, end date).
  IMPORTED

  @@map("membership_event")
}

/// Append-only (UPDATE, DELETE and TRUNCATE are rejected by triggers, like audit_logs).
/// changed_by has no foreign key for the same reason as audit_logs.actor_user_id.
model MembershipHistory {
  id           String          @id @db.Uuid
  membershipId String          @map("membership_id") @db.Uuid
  event        MembershipEvent
  fromStatus   String?         @map("from_status") @db.VarChar(32)
  toStatus     String?         @map("to_status") @db.VarChar(32)
  /// Type key, end date or payment status after the change, as relevant to the event.
  details      Json?
  changedBy    String?         @map("changed_by") @db.Uuid
  reason       String?         @db.VarChar(1000)
  at           DateTime        @default(now()) @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, at])
  @@map("membership_history")
}

/// ARCHITECTURE.md §7: PENDING_DIRECTOR → PENDING_ADMIN → APPROVED, or REJECTED / WITHDRAWN.
enum VerificationState {
  PENDING_DIRECTOR
  PENDING_ADMIN
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("verification_state")
}

/// A membership application. One open application per user (partial unique index).
model VerificationRequest {
  id             String            @id @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  /// The organisation applied to: that of the membership type. (M16)
  organisationId String            @map("organisation_id") @db.Uuid
  typeId         String            @map("type_id") @db.Uuid
  hospitalId     String?           @map("hospital_id") @db.Uuid
  departmentId   String?           @map("department_id") @db.Uuid
  state          VerificationState
  /// NO_DIRECTOR: the department has no director. APPLICANT_IS_DIRECTOR: its only director applied.
  flags          String[]          @default([])
  identifierEnc  String?           @map("identifier_enc")
  identifierHash String?           @map("identifier_hash") @db.VarChar(128)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         MembershipType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  hospital     Hospital?              @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department   Department?            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  decisions    VerificationDecision[]
  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([state, departmentId])
  @@index([userId])
  @@map("verification_requests")
}

enum VerificationStage {
  DIRECTOR
  ADMIN

  @@map("verification_stage")
}

enum VerificationOutcome {
  APPROVE
  REJECT

  @@map("verification_outcome")
}

/// Append-only, like membership_history.
model VerificationDecision {
  id        String              @id @db.Uuid
  requestId String              @map("request_id") @db.Uuid
  stage     VerificationStage
  decision  VerificationOutcome
  decidedBy String?             @map("decided_by") @db.Uuid
  reason    String?             @db.VarChar(1000)
  at        DateTime            @default(now()) @db.Timestamptz(6)

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, at])
  @@map("verification_decisions")
}

enum ImportBatchStatus {
  DRY_RUN
  APPLIED

  @@map("import_batch_status")
}

/// A CSV membership import (D2, the IMA source-of-truth workflow). Holds the dry-run report and a
/// keyed hash of the file, never the file: applying requires the same file again, so certificate
/// and licence numbers are not kept here.
model ImportBatch {
  id             String            @id @db.Uuid
  createdBy      String?           @map("created_by") @db.Uuid
  /// Whose it is. Every one belongs to an organisation. (M16)
  organisationId String            @map("organisation_id") @db.Uuid
  fileName       String?           @map("file_name") @db.VarChar(255)
  contentHash    String            @map("content_hash") @db.VarChar(128)
  status         ImportBatchStatus @default(DRY_RUN)
  /// Per-row outcome (line, email, action, reasons) and totals. No identifiers.
  report         Json
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  appliedAt      DateTime?         @map("applied_at") @db.Timestamptz(6)
  appliedBy      String?           @map("applied_by") @db.Uuid

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Files (M3). DATABASE_DESIGN.md §3 "Files"; SECURITY_MODEL.md "Files".
// ---------------------------------------------------------------------------

enum FileKind {
  IMAGE
  DOCUMENT
  /// An MP4 sent in chat, stored as it was uploaded (M13).
  VIDEO

  @@map("file_kind")
}

enum FilePurpose {
  /// Content images and documents, uploaded by staff.
  CONTENT
  /// A member's own profile photo.
  PROFILE_PHOTO
  /// Sent in a chat message: readable by whoever can read that message (M13).
  CHAT
  /// A student's confirmation from their medical school (M17): its uploader and the platform's
  /// reviewers only, and deleted once it is decided on.
  VERIFICATION

  @@map("file_purpose")
}

enum ScanStatus {
  UNSCANNED
  CLEAN
  INFECTED
  ERROR

  @@map("scan_status")
}

/// An uploaded file. The bytes live in object storage under a random key, never in the web root.
/// Images are stored re-encoded, without metadata. Downloads go through short-lived signed URLs
/// after an access check.
model StoredFile {
  id           String      @id @db.Uuid
  storageKey   String      @unique @map("storage_key") @db.VarChar(200)
  /// Smaller copy of an image (for lists and avatars).
  thumbnailKey String?     @unique @map("thumbnail_key") @db.VarChar(200)
  /// The uploaded name, cleaned (shown to users and used for downloads).
  originalName String      @map("original_name") @db.VarChar(255)
  /// Detected from the content, never taken from the client.
  mimeType     String      @map("mime_type") @db.VarChar(120)
  kind         FileKind
  purpose      FilePurpose
  sizeBytes    Int         @map("size_bytes")
  sha256       String      @db.Char(64)
  width        Int?
  height       Int?
  scanStatus   ScanStatus  @default(UNSCANNED) @map("scan_status")
  ownerUserId  String?     @map("owner_user_id") @db.Uuid
  /// Set when something uses the file; unused uploads are removed after a day.
  attachedAt   DateTime?   @map("attached_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  owner           User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  profilePhoto    Profile?               @relation("ProfilePhoto")
  newsFeatured    News[]
  newsAttachment  NewsAttachment[]
  eventImage      Event[]
  educationCover  EducationItem[]        @relation("EducationCover")
  educationFile   EducationFile[]        @relation("EducationFile")
  speakerPhoto    Speaker[]
  sessionMaterial SessionMaterial[]
  roomPicture     Conversation[]         @relation("RoomPicture")
  verification    PhysicianVerification?
  chatAttachment  MessageAttachment[]    @relation("MessageAttachment")

  @@index([attachedAt, createdAt])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Content access tiers (M3, D7). DATABASE_DESIGN.md §3 "Content".
// ---------------------------------------------------------------------------

/// Who may read a content item. Everything defaults to PUBLIC (D7).
enum AccessTier {
  PUBLIC
  /// Anyone the platform knows as a physician, in any organisation or none. (M16)
  VERIFIED
  /// Active members of the organisation that owns the item. Not for the platform's own items.
  MEMBERS
  /// Active members of the membership types listed in content_access_rules.
  TYPES

  @@map("access_tier")
}

/// The membership types allowed to read an item whose tier is TYPES.
model ContentAccessRule {
  /// "news", "guideline", … (later: "event", "education").
  entityType       String @map("entity_type") @db.VarChar(40)
  entityId         String @map("entity_id") @db.Uuid
  membershipTypeId String @map("membership_type_id") @db.Uuid

  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id], onDelete: Restrict)

  @@id([entityType, entityId, membershipTypeId])
  @@index([entityType, membershipTypeId])
  @@map("content_access_rules")
}

// ---------------------------------------------------------------------------
// News (M3). DATABASE_DESIGN.md §3 "Content"; ADR 0005 (translation tables).
// ---------------------------------------------------------------------------

/// DRAFT → IN_REVIEW → SCHEDULED or PUBLISHED → ARCHIVED (M3 plan §3).
enum NewsStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED

  @@map("news_status")
}

/// Admin-editable news categories (names in Hebrew and English).
model NewsCategory {
  id        String   @id @db.Uuid
  key       String   @unique @db.VarChar(64)
  nameHe    String   @map("name_he") @db.VarChar(200)
  nameEn    String   @map("name_en") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  news News[]

  @@map("news_categories")
}

/// A news item. The text lives in news_translations (one row per language). Editing a published
/// item creates a revision: another row pointing at it (revision_of_id), which goes through the
/// same workflow; publishing the revision copies it onto the live item.
model News {
  id                  String     @id @db.Uuid
  /// URL name; null for revisions (they use the live item's).
  slug                String?    @unique @db.VarChar(160)
  status              NewsStatus @default(DRAFT)
  categoryId          String?    @map("category_id") @db.Uuid
  authorUserId        String?    @map("author_user_id") @db.Uuid
  /// Who submitted it for review (four eyes: they can't approve it).
  submittedBy         String?    @map("submitted_by") @db.Uuid
  featuredImageFileId String?    @map("featured_image_file_id") @db.Uuid
  accessTier          AccessTier @default(PUBLIC) @map("access_tier")
  /// Whose it is. Empty: the platform's own. (M16)
  organisationId      String?    @map("organisation_id") @db.Uuid
  /// When a SCHEDULED item goes live.
  publishAt           DateTime?  @map("publish_at") @db.Timestamptz(6)
  publishedAt         DateTime?  @map("published_at") @db.Timestamptz(6)
  archivedAt          DateTime?  @map("archived_at") @db.Timestamptz(6)
  /// Imported items (M4) keep their source and original date.
  sourceUrl           String?    @unique @map("source_url") @db.VarChar(500)
  sourcePublishedAt   DateTime?  @map("source_published_at") @db.Timestamptz(6)
  /// [{ "title": "...", "url": "https://..." }]
  references          Json       @default("[]")
  revisionOfId        String?    @unique @map("revision_of_id") @db.Uuid
  /// Increases on every change; the ETag for concurrent edits.
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      NewsCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author        User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  featuredImage StoredFile?       @relation(fields: [featuredImageFileId], references: [id], onDelete: SetNull)
  revisionOf    News?             @relation("NewsRevision", fields: [revisionOfId], references: [id], onDelete: Cascade)
  revision      News?             @relation("NewsRevision")
  translations  NewsTranslation[]
  attachments   NewsAttachment[]
  tags          NewsTag[]
  history       NewsHistory[]
  organisation  Organisation?     @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, publishAt])
  @@index([organisationId])
  @@map("news")
}

model NewsTranslation {
  newsId       String                   @map("news_id") @db.Uuid
  locale       String                   @db.VarChar(8)
  title        String                   @db.VarChar(300)
  summary      String?                  @db.VarChar(1000)
  /// Sanitised Markdown (M3 plan §11).
  body         String                   @default("")
  /// The byline as shown (e.g. "Prof. …" or "The board"); empty means the account's name.
  author       String?                  @db.VarChar(200)
  /// Maintained by a trigger from title, summary and body (Hebrew-normalised). Search is M7.
  searchVector Unsupported("tsvector")? @map("search_vector")

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([newsId, locale])
  @@index([searchVector], map: "news_translations_search_idx", type: Gin)
  @@map("news_translations")
}

model NewsAttachment {
  newsId    String @map("news_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  news News       @relation(fields: [newsId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([newsId, fileId])
  @@index([fileId])
  @@map("news_attachments")
}

model Tag {
  id   String @id @db.Uuid
  name String @unique @db.Citext

  news NewsTag[]

  @@map("tags")
}

model NewsTag {
  newsId String @map("news_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([newsId, tagId])
  @@map("news_tags")
}

/// Append-only workflow history (like membership_history).
model NewsHistory {
  id          String      @id @db.Uuid
  newsId      String      @map("news_id") @db.Uuid
  action      String      @db.VarChar(40)
  fromStatus  NewsStatus? @map("from_status")
  toStatus    NewsStatus  @map("to_status")
  actorUserId String?     @map("actor_user_id") @db.Uuid
  comment     String?     @db.VarChar(1000)
  at          DateTime    @default(now()) @db.Timestamptz(6)

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId, at])
  @@map("news_history")
}

// ---------------------------------------------------------------------------
// Guidelines (M3). Metadata and official links only: third-party guideline documents are never
// copied (spec §14, PRODUCT_REQUIREMENTS §3.8).
// ---------------------------------------------------------------------------

/// The state of the guideline itself (M3 plan §11.7). All three stay listed.
enum GuidelineStatus {
  CURRENT
  SUPERSEDED
  WITHDRAWN

  @@map("guideline_status")
}

model Guideline {
  id             String          @id @db.Uuid
  /// The organisation that published it (e.g. "EAU"), named as the source only.
  sourceOrg      String          @map("source_org") @db.VarChar(200)
  /// The guideline's page at the source organisation.
  officialUrl    String          @map("official_url") @db.VarChar(500)
  /// Free text: organisations grade evidence on different scales.
  evidenceLevel  String?         @map("evidence_level") @db.VarChar(100)
  status         GuidelineStatus @default(CURRENT)
  subspecialtyId String?         @map("subspecialty_id") @db.Uuid
  accessTier     AccessTier      @default(PUBLIC) @map("access_tier")
  /// Imported entries (M4): the page of the source site the entry was read from.
  sourceUrl      String?         @map("source_url") @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  subspecialty Subspecialty?          @relation(fields: [subspecialtyId], references: [id], onDelete: Restrict)
  translations GuidelineTranslation[]
  versions     GuidelineVersion[]

  @@unique([sourceUrl, officialUrl])
  @@index([status])
  @@index([subspecialtyId])
  @@map("guidelines")
}

model GuidelineTranslation {
  guidelineId  String                   @map("guideline_id") @db.Uuid
  locale       String                   @db.VarChar(8)
  title        String                   @db.VarChar(300)
  /// An optional summary written by the editors (plain text), never the source's own text.
  summary      String?                  @db.VarChar(4000)
  /// Maintained by a trigger from title and summary (Hebrew-normalised). Search is M7.
  searchVector Unsupported("tsvector")? @map("search_vector")

  guideline Guideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)

  @@id([guidelineId, locale])
  @@index([searchVector], map: "guideline_translations_search_idx", type: Gin)
  @@map("guideline_translations")
}

/// One published edition. The newest by date is the guideline's current version and date.
model GuidelineVersion {
  id          String   @id @db.Uuid
  guidelineId String   @map("guideline_id") @db.Uuid
  version     String   @db.VarChar(60)
  publishedOn DateTime @map("published_on") @db.Date
  /// The source states only a year: show the year, not the day and month (M4 plan §11.7).
  yearOnly    Boolean  @default(false) @map("year_only")
  /// This edition's own page, when it differs from the guideline's official link.
  url         String?  @db.VarChar(500)
  licenseNote String?  @map("license_note") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guideline Guideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)

  @@unique([guidelineId, version])
  @@index([guidelineId, publishedOn(sort: Desc)])
  @@map("guideline_versions")
}

// ---------------------------------------------------------------------------
// Events (M5). DATABASE_DESIGN.md §3; docs/plans/M5-events.md.
// ---------------------------------------------------------------------------

/// DRAFT → PUBLISHED → CANCELLED. A cancelled event stays visible, marked as cancelled.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("event_status")
}

/// How people sign up: in the app, on another site, or not at all.
enum RegistrationMode {
  INTERNAL
  EXTERNAL
  NONE

  @@map("registration_mode")
}

model EventCategory {
  id        String   @id @db.Uuid
  key       String   @unique @db.VarChar(64)
  nameHe    String   @map("name_he") @db.VarChar(200)
  nameEn    String   @map("name_en") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_categories")
}

model Event {
  id               String           @id @db.Uuid
  slug             String           @unique @db.VarChar(160)
  status           EventStatus      @default(DRAFT)
  categoryId       String?          @map("category_id") @db.Uuid
  /// Required once published; a draft (e.g. an imported page without dates) may lack them.
  startAt          DateTime?        @map("start_at") @db.Timestamptz(6)
  endAt            DateTime?        @map("end_at") @db.Timestamptz(6)
  /// IANA zone the times were entered in (API_DESIGN.md §2).
  timezone         String           @default("Asia/Jerusalem") @db.VarChar(64)
  locationName     String?          @map("location_name") @db.VarChar(300)
  address          String?          @db.VarChar(500)
  lat              Decimal?         @db.Decimal(9, 6)
  lng              Decimal?         @db.Decimal(9, 6)
  organizer        String?          @db.VarChar(300)
  imageFileId      String?          @map("image_file_id") @db.Uuid
  registrationMode RegistrationMode @default(NONE) @map("registration_mode")
  /// For EXTERNAL registration: the other site's page.
  registrationUrl  String?          @map("registration_url") @db.VarChar(500)
  /// Places for in-app registration; null means unlimited.
  capacity         Int?
  cmeAvailable     Boolean          @default(false) @map("cme_available")
  accessTier       AccessTier       @default(PUBLIC) @map("access_tier")
  /// Whose it is. Empty: the platform's own. (M16)
  organisationId   String?          @map("organisation_id") @db.Uuid
  /// Imported events (M4 fixtures): the page of the source site.
  sourceUrl        String?          @unique @map("source_url") @db.VarChar(500)
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(6)
  cancelledAt      DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason     String?          @map("cancel_reason") @db.VarChar(1000)
  createdBy        String?          @map("created_by") @db.Uuid
  /// Increases on every change; the ETag for concurrent edits.
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      EventCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  image         StoredFile?         @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  translations  EventTranslation[]
  sessions      EventSession[]
  registrations EventRegistration[]
  attendance    EventAttendance[]
  reminders     EventReminder[]
  organisation  Organisation?       @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([status, startAt])
  @@index([organisationId])
  @@map("events")
}

model EventTranslation {
  eventId      String                   @map("event_id") @db.Uuid
  locale       String                   @db.VarChar(8)
  title        String                   @db.VarChar(300)
  summary      String?                  @db.VarChar(1000)
  /// Sanitised Markdown, like news bodies.
  description  String                   @default("")
  /// Maintained by a trigger from title, summary and description. Search is M7.
  searchVector Unsupported("tsvector")? @map("search_vector")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, locale])
  @@index([searchVector], map: "event_translations_search_idx", type: Gin)
  @@map("event_translations")
}

/// A session of an event: a talk, a workshop, a break. It lies inside the event's time span.
model EventSession {
  id        String   @id @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  room      String?  @db.VarChar(200)
  startAt   DateTime @map("start_at") @db.Timestamptz(6)
  endAt     DateTime @map("end_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations EventSessionTranslation[]
  speakers     SessionSpeaker[]
  materials    SessionMaterial[]
  scheduled    ScheduleItem[]
  attendance   EventAttendance[]

  @@index([eventId, startAt])
  @@map("event_sessions")
}

model EventSessionTranslation {
  sessionId    String                   @map("session_id") @db.Uuid
  locale       String                   @db.VarChar(8)
  title        String                   @db.VarChar(300)
  /// Plain text.
  description  String?                  @db.VarChar(4000)
  /// Maintained by a trigger from title and description. Search is M7.
  searchVector Unsupported("tsvector")? @map("search_vector")

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, locale])
  @@index([searchVector], map: "event_session_translations_search_idx", type: Gin)
  @@map("event_session_translations")
}

/// A speaker is a record, not an account (M5 plan §2.2). Demo speakers are fictional.
model Speaker {
  id             String   @id @db.Uuid
  /// Whose list of speakers the record is in; empty: the platform's. (M16)
  organisationId String?  @map("organisation_id") @db.Uuid
  photoFileId    String?  @map("photo_file_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  photo        StoredFile?          @relation(fields: [photoFileId], references: [id], onDelete: SetNull)
  organisation Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  translations SpeakerTranslation[]
  sessions     SessionSpeaker[]

  @@index([organisationId])
  @@map("speakers")
}

model SpeakerTranslation {
  speakerId   String  @map("speaker_id") @db.Uuid
  locale      String  @db.VarChar(8)
  name        String  @db.VarChar(200)
  /// For example "Prof." or "Dr.".
  title       String? @db.VarChar(100)
  affiliation String? @db.VarChar(300)
  bio         String? @db.VarChar(2000)

  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([speakerId, locale])
  @@map("speaker_translations")
}

model SessionSpeaker {
  sessionId String @map("session_id") @db.Uuid
  speakerId String @map("speaker_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker Speaker      @relation(fields: [speakerId], references: [id], onDelete: Restrict)

  @@id([sessionId, speakerId])
  @@index([speakerId])
  @@map("session_speakers")
}

model SessionMaterial {
  sessionId String @map("session_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  file    StoredFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([sessionId, fileId])
  @@index([fileId])
  @@map("session_materials")
}

/// REGISTERED holds a place; WAITLISTED waits for one (M5 plan §11.2); CANCELLED gave it up.
enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED

  @@map("registration_status")
}

/// One row per person per event. Registering again after cancelling reuses the row.
model EventRegistration {
  id          String             @id @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  status      RegistrationStatus
  /// When the person (re)joined: the order of the waiting list.
  queuedAt    DateTime           @default(now()) @map("queued_at") @db.Timestamptz(6)
  /// When a waiting person was given a place.
  promotedAt  DateTime?          @map("promoted_at") @db.Timestamptz(6)
  cancelledAt DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status, queuedAt])
  @@index([userId])
  @@map("event_registrations")
}

/// A session the member put in their personal schedule (only while registered for its event).
model ScheduleItem {
  userId    String   @map("user_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([userId, sessionId])
  @@index([sessionId])
  @@map("schedule_items")
}

/// How an attendance record was made: the member scanned the venue's QR code, or an event admin
/// marked them by hand.
enum AttendanceMethod {
  QR
  MANUAL

  @@map("attendance_method")
}

/// Who attended an event, or one of its sessions (session_id set). Append-only: a record is
/// never changed or deleted; a wrong one is voided, once, with a reason (M5 plan §3). Kept ready
/// for CME points in Phase 2.
model EventAttendance {
  id         String           @id @db.Uuid
  eventId    String           @map("event_id") @db.Uuid
  /// Null: attendance at the event as a whole.
  sessionId  String?          @map("session_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  method     AttendanceMethod
  /// The event admin who marked it by hand. Null for a QR check-in.
  recordedBy String?          @map("recorded_by") @db.Uuid
  at         DateTime         @default(now()) @db.Timestamptz(6)
  voidedAt   DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidedBy   String?          @map("voided_by") @db.Uuid
  voidReason String?          @map("void_reason") @db.VarChar(500)

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, at])
  @@index([userId])
  @@map("event_attendance")
}

/// Which reminder: a week before the event, or a day before (M5 plan §11.4).
enum ReminderKind {
  WEEK
  DAY

  @@map("reminder_kind")
}

/// A reminder that was sent. The row is written before the email goes out, so a reminder is
/// never sent twice, even if the job runs twice or is interrupted.
model EventReminder {
  eventId String       @map("event_id") @db.Uuid
  userId  String       @map("user_id") @db.Uuid
  kind    ReminderKind
  sentAt  DateTime     @default(now()) @map("sent_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId, kind])
  @@map("event_reminders")
}

// ---------------------------------------------------------------------------
// Education (M6). DATABASE_DESIGN.md §3; docs/plans/M6-education.md.
// ---------------------------------------------------------------------------

/// The content types of spec §12.
enum EducationType {
  VIDEO
  ARTICLE
  PDF
  PRESENTATION
  PODCAST
  WEBINAR
  SURGICAL_VIDEO
  CASE
  COURSE

  @@map("education_type")
}

/// Who the item is written for. Null on an item means all levels.
enum EducationLevel {
  STUDENT
  RESIDENT
  FELLOW
  SPECIALIST
  EXPERT

  @@map("education_level")
}

/// DRAFT → IN_REVIEW → PUBLISHED → ARCHIVED (M6 plan §3). Shared by items and exam questions.
enum EducationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("education_status")
}

/// Videos are links to where they are hosted (ADR 0008). PENDING_PROVIDER: no link yet.
enum VideoStatus {
  NONE
  EXTERNAL
  PENDING_PROVIDER

  @@map("video_status")
}

model EducationItem {
  id              String          @id @db.Uuid
  slug            String          @unique @db.VarChar(160)
  type            EducationType
  status          EducationStatus @default(DRAFT)
  level           EducationLevel?
  subspecialtyId  String?         @map("subspecialty_id") @db.Uuid
  durationMinutes Int?            @map("duration_minutes")
  /// Shown only; CME tracking is Phase 2.
  cmePoints       Decimal?        @map("cme_points") @db.Decimal(5, 2)
  /// Where a video, webinar or podcast is hosted (opened there, never embedded).
  externalUrl     String?         @map("external_url") @db.VarChar(500)
  videoStatus     VideoStatus     @default(NONE) @map("video_status")
  accessTier      AccessTier      @default(PUBLIC) @map("access_tier")
  coverFileId     String?         @map("cover_file_id") @db.Uuid
  /// [{ "title": "...", "url": "https://..." }]
  references      Json            @default("[]")
  authorUserId    String?         @map("author_user_id") @db.Uuid
  /// Who submitted it for review (four eyes: they can't approve it).
  submittedBy     String?         @map("submitted_by") @db.Uuid
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(6)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)
  /// Increases on every change; the ETag for concurrent edits.
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  subspecialty Subspecialty?          @relation(fields: [subspecialtyId], references: [id], onDelete: Restrict)
  cover        StoredFile?            @relation("EducationCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  translations EducationTranslation[]
  files        EducationFile[]
  history      EducationHistory[]
  /// For a course: its lessons. For any other item: the courses it is a lesson of.
  lessons      CourseItem[]           @relation("CourseLessons")
  inCourses    CourseItem[]           @relation("LessonOf")

  @@index([status, publishedAt(sort: Desc)])
  @@index([type, level, subspecialtyId])
  @@map("education_items")
}

model EducationTranslation {
  itemId       String                   @map("item_id") @db.Uuid
  locale       String                   @db.VarChar(8)
  title        String                   @db.VarChar(300)
  /// Sanitised Markdown: the description, or the whole text of an article or case.
  description  String                   @default("")
  /// The byline as shown.
  author       String?                  @db.VarChar(200)
  /// Maintained by a trigger from title and description. Search is M7.
  searchVector Unsupported("tsvector")? @map("search_vector")

  item EducationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, locale])
  @@index([searchVector], map: "education_translations_search_idx", type: Gin)
  @@map("education_translations")
}

model EducationFile {
  itemId    String @map("item_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  item EducationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file StoredFile    @relation("EducationFile", fields: [fileId], references: [id], onDelete: Cascade)

  @@id([itemId, fileId])
  @@index([fileId])
  @@map("education_files")
}

/// A lesson of a course, in order. A course is never a lesson (a database trigger checks it).
model CourseItem {
  courseId String @map("course_id") @db.Uuid
  itemId   String @map("item_id") @db.Uuid
  position Int

  course EducationItem @relation("CourseLessons", fields: [courseId], references: [id], onDelete: Cascade)
  item   EducationItem @relation("LessonOf", fields: [itemId], references: [id], onDelete: Cascade)

  @@id([courseId, itemId])
  @@unique([courseId, position])
  @@index([itemId])
  @@map("course_items")
}

/// Append-only workflow history (like news_history).
model EducationHistory {
  id          String           @id @db.Uuid
  itemId      String           @map("item_id") @db.Uuid
  action      String           @db.VarChar(40)
  fromStatus  EducationStatus? @map("from_status")
  toStatus    EducationStatus  @map("to_status")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  comment     String?          @db.VarChar(1000)
  at          DateTime         @default(now()) @db.Timestamptz(6)

  item EducationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, at])
  @@map("education_history")
}

// ---------------------------------------------------------------------------
// Exam question demo (M6 plan §2.10). One question at a time; after the reader answers, the
// right option, why each option is right or wrong, and a short summary of the topic.
// ---------------------------------------------------------------------------

/// How hard the author judges a question (M23).
enum ExamDifficulty {
  EASY
  MEDIUM
  HARD

  @@map("exam_difficulty")
}

model ExamQuestion {
  id             String          @id @db.Uuid
  status         EducationStatus @default(DRAFT)
  level          EducationLevel?
  difficulty     ExamDifficulty?
  /// [{ title, url? }]: what the right answer rests on, shown with the explanation (M23).
  references     Json            @default("[]")
  /// Where the question comes from, for the reviewer only (M23), e.g. "written new by …".
  source         String?         @db.VarChar(500)
  /// Who published it and when, shown to readers as "Reviewed by … on …" (M23). The names are
  /// kept as they were when it was published.
  reviewedBy     String?         @map("reviewed_by") @db.Uuid
  reviewerNameHe String?         @map("reviewer_name_he") @db.VarChar(200)
  reviewerNameEn String?         @map("reviewer_name_en") @db.VarChar(200)
  reviewedAt     DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  subspecialtyId String?         @map("subspecialty_id") @db.Uuid
  accessTier     AccessTier      @default(PUBLIC) @map("access_tier")
  authorUserId   String?         @map("author_user_id") @db.Uuid
  /// Who submitted it for review (four eyes: the same person cannot approve it).
  submittedBy    String?         @map("submitted_by") @db.Uuid
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(6)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(6)
  /// Increases on every change; the ETag for concurrent edits.
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  subspecialty Subspecialty?             @relation(fields: [subspecialtyId], references: [id], onDelete: Restrict)
  translations ExamQuestionTranslation[]
  options      ExamOption[]
  history      ExamQuestionHistory[]
  answers      ExamAnswer[]
  bookmarks    ExamBookmark[]
  reports      ExamReport[]
  mockItems    MockExamQuestion[]

  @@index([status, level, subspecialtyId])
  @@map("exam_questions")
}

model ExamQuestionTranslation {
  questionId String @map("question_id") @db.Uuid
  locale     String @db.VarChar(8)
  /// The question as asked.
  stem       String @db.VarChar(4000)
  /// A short summary of the topic, shown after the reader answers.
  summary    String @db.VarChar(4000)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, locale])
  @@map("exam_question_translations")
}

/// One answer option. Exactly one option of a question is the right one (a partial unique index).
model ExamOption {
  id         String  @id @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  /// 1 is shown first ("A").
  position   Int
  isCorrect  Boolean @default(false) @map("is_correct")

  question     ExamQuestion            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations ExamOptionTranslation[]

  @@unique([questionId, position])
  @@map("exam_options")
}

model ExamOptionTranslation {
  optionId    String @map("option_id") @db.Uuid
  locale      String @db.VarChar(8)
  text        String @db.VarChar(1000)
  /// Why this option is right, or why it is wrong.
  explanation String @db.VarChar(4000)

  option ExamOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@map("exam_option_translations")
}

/// Append-only workflow history (like education_history).
model ExamQuestionHistory {
  id          String           @id @db.Uuid
  questionId  String           @map("question_id") @db.Uuid
  action      String           @db.VarChar(40)
  fromStatus  EducationStatus? @map("from_status")
  toStatus    EducationStatus  @map("to_status")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  comment     String?          @db.VarChar(1000)
  at          DateTime         @default(now()) @db.Timestamptz(6)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, at])
  @@map("exam_question_history")
}

/// An answer by a signed-in person (owner answer §11.8). Visible only to that person; deleted
/// with their account. The first answer to a question counts for the score.
model ExamAnswer {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  /// The position of the option chosen (options may be reworded later; the choice is kept).
  position   Int
  correct    Boolean
  /// True for the first answer of this person to this question: the one that counts.
  counts     Boolean
  /// The mock exam it was given in (M23); empty for practice.
  mockExamId String?  @map("mock_exam_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mockExam MockExam?    @relation(fields: [mockExamId], references: [id], onDelete: Cascade)

  @@index([userId, at(sort: Desc)])
  @@index([questionId])
  @@map("exam_answers")
}

/// A timed mock exam (M23 plan §2). The server keeps the clock: an answer after endsAt is
/// refused. Answers wait in mock_exam_questions until the exam ends; then they are written to
/// exam_answers, marked with the exam. Only its person reads it; deleted with their account.
model MockExam {
  id               String          @id @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  level            EducationLevel?
  /// The topics chosen (subspecialty keys); empty for all.
  subspecialtyKeys String[]        @default([]) @map("subspecialty_keys")
  startedAt        DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt           DateTime        @map("ends_at") @db.Timestamptz(6)
  /// Set when the person finishes or the time is up.
  finishedAt       DateTime?       @map("finished_at") @db.Timestamptz(6)
  correct          Int?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions MockExamQuestion[]
  answers   ExamAnswer[]

  @@index([userId, startedAt(sort: Desc)])
  @@map("mock_exams")
}

model MockExamQuestion {
  examId         String    @map("exam_id") @db.Uuid
  /// 1 is the first question.
  position       Int
  questionId     String    @map("question_id") @db.Uuid
  /// The option chosen so far; it may change until the exam ends.
  chosenPosition Int?      @map("chosen_position")
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(6)

  exam     MockExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, position])
  @@unique([examId, questionId])
  @@index([questionId])
  @@map("mock_exam_questions")
}

/// A question a person keeps to return to (M23). Theirs alone.
model ExamBookmark {
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
  @@map("exam_bookmarks")
}

enum ExamReportReason {
  WRONG_ANSWER
  UNCLEAR
  OUTDATED
  TYPO
  OTHER

  @@map("exam_report_reason")
}

enum ExamReportStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("exam_report_status")
}

/// A reader says what is wrong with a question (M23). It goes to the question reviewers' queue,
/// and the reader is told when it is dealt with. Staff never see who sent it.
model ExamReport {
  id         String           @id @db.Uuid
  questionId String           @map("question_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  reason     ExamReportReason
  text       String           @default("") @db.VarChar(1000)
  status     ExamReportStatus @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  handledAt  DateTime?        @map("handled_at") @db.Timestamptz(6)
  handledBy  String?          @map("handled_by") @db.Uuid
  /// What the reviewer tells the reader.
  response   String?          @db.VarChar(1000)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([questionId])
  @@index([userId])
  @@map("exam_reports")
}

// ---------------------------------------------------------------------------
// Notifications (M7). DATABASE_DESIGN.md §3; docs/plans/M7-notifications-search.md.
// ---------------------------------------------------------------------------

/// What a notice is about; the person sets each kind per channel (M7 plan §2.2).
enum NotificationKind {
  ACCOUNT
  MY_EVENTS
  ASSOCIATION
  NEWS
  NEW_EVENTS
  EDUCATION
  GUIDELINES
  /// Staff work (an item sent back or published). Always on; not in the preferences.
  WORK
  /// Private messages in chat (M11): the number on the Chat link, and one email a day at most.
  MESSAGES
  /// Chat rooms (M12): someone mentioned you or replied to you, or an announcement in your room.
  ROOMS

  @@map("notification_kind")
}

enum NotificationChannel {
  APP
  EMAIL

  @@map("notification_channel")
}

/// A notice in the app. Stored as a type and its details, and worded in the reader's language
/// when shown. Deleted after 180 days, and with the account.
model Notification {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  /// The message key, e.g. "eventReminder".
  type      String           @db.VarChar(60)
  /// The values the message needs (titles, dates). No secrets and no links with tokens.
  params    Json             @default("{}")
  /// A path inside the site, without the language prefix.
  link      String?          @db.VarChar(500)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}

/// A switch the person set. A missing row means the starting setting of the kind.
model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  kind      NotificationKind
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, channel])
  @@map("notification_preferences")
}

/// Something newly published that people are told about once (M7 plan §2.3): a notice in the app
/// and a line in the next daily summary email. One row per item, not per person: who sees it is
/// worked out when a person opens their notices (their switches, their membership), so publishing
/// costs the same however many accounts there are. Publishing an item again tells nobody twice. The access tier is kept as it was when the item was published.
model ContentAnnouncement {
  id             String           @id @db.Uuid
  /// "news", "event", "education", "guideline" or "guideline_version".
  entityType     String           @map("entity_type") @db.VarChar(40)
  entityId       String           @map("entity_id") @db.Uuid
  kind           NotificationKind
  /// The message key of the notice, e.g. "contentNews".
  type           String           @db.VarChar(60)
  titleHe        String?          @map("title_he") @db.VarChar(300)
  titleEn        String?          @map("title_en") @db.VarChar(300)
  /// A path inside the site, without the language prefix.
  link           String           @db.VarChar(500)
  accessTier     AccessTier       @map("access_tier")
  /// Who published the item: an organisation, or null for the platform. Decides who "members" are.
  organisationId String?          @map("organisation_id") @db.Uuid
  /// The membership types that may read it, when the tier is TYPES.
  typeIds        String[]         @default([]) @map("type_ids") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when a daily summary took it; null means the next summary lists it.
  digestedAt     DateTime?        @map("digested_at") @db.Timestamptz(6)

  reads AnnouncementRead[]

  @@unique([entityType, entityId])
  @@index([digestedAt])
  @@index([createdAt(sort: Desc)])
  @@map("content_announcements")
}

/// An announcement a person marked as read.
model AnnouncementRead {
  userId         String   @map("user_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement ContentAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([announcementId])
  @@map("announcement_reads")
}

/// "Mark all as read" for announcements: everything up to this moment counts as read.
model NotificationState {
  userId                 String   @id @map("user_id") @db.Uuid
  announcementsReadUntil DateTime @map("announcements_read_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_state")
}

// ---------------------------------------------------------------------------
// Broadcasts (M7 plan §2.6): a message an admin writes and a different admin approves.
// ---------------------------------------------------------------------------

/// DRAFT → PENDING_APPROVAL → SENT, or REJECTED (back to its author, who may edit and resubmit).
enum BroadcastStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  REJECTED

  @@map("broadcast_status")
}

model Broadcast {
  id             String          @id @db.Uuid
  status         BroadcastStatus @default(DRAFT)
  createdBy      String          @map("created_by") @db.Uuid
  /// Whose it is. Empty: the platform's own. (M16)
  organisationId String?         @map("organisation_id") @db.Uuid
  /// True: every active member. False: the membership types in type_ids.
  audienceAll    Boolean         @default(true) @map("audience_all")
  typeIds        String[]        @default([]) @map("type_ids") @db.Uuid
  submittedAt    DateTime?       @map("submitted_at") @db.Timestamptz(6)
  /// Who approved or rejected it. Never the author (a database check).
  decidedBy      String?         @map("decided_by") @db.Uuid
  decidedAt      DateTime?       @map("decided_at") @db.Timestamptz(6)
  rejectReason   String?         @map("reject_reason") @db.VarChar(1000)
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(6)
  /// How many people it reached, fixed when it was sent.
  recipientCount Int?            @map("recipient_count")
  /// From the Idempotency-Key header: sending the same request twice creates one broadcast.
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations BroadcastTranslation[]
  deliveries   BroadcastDelivery[]
  organisation Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([createdBy, idempotencyKey])
  @@index([status, createdAt(sort: Desc)])
  @@index([organisationId])
  @@map("broadcasts")
}

model BroadcastTranslation {
  broadcastId String @map("broadcast_id") @db.Uuid
  locale      String @db.VarChar(8)
  title       String @db.VarChar(200)
  /// Plain text; blank lines separate paragraphs.
  body        String @db.VarChar(5000)

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@id([broadcastId, locale])
  @@map("broadcast_translations")
}

/// One row per person a broadcast reached: nobody receives it twice, also when sending is
/// retried, and only these people can read it.
model BroadcastDelivery {
  broadcastId String    @map("broadcast_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// Set when the email was handed to the mailer, or when the person had email switched off.
  emailedAt   DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([broadcastId, userId])
  @@index([emailedAt])
  @@index([userId])
  @@map("broadcast_deliveries")
}

// ---------------------------------------------------------------------------
// Consents (M7 plan §2.8). DATABASE_DESIGN.md §3.
// ---------------------------------------------------------------------------

enum ConsentKind {
  TERMS
  PRIVACY
  /// Being listed in the member directory.
  DIRECTORY
  EMAIL_MARKETING

  @@map("consent_kind")
}

/// A consent a person gave, with the wording version they saw. Kept as history: withdrawing sets
/// withdrawn_at, and giving it again adds a row. Deleted with the account.
model Consent {
  id          String      @id @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  kind        ConsentKind
  /// The version of the wording shown, e.g. "directory-2026-10".
  version     String      @db.VarChar(40)
  grantedAt   DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt DateTime?   @map("withdrawn_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, grantedAt(sort: Desc)])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Site settings (M8 plan §2.5). The allowed keys and the shape of each value are fixed in code.
// ---------------------------------------------------------------------------

model Setting {
  /// "contact" or "notice".
  key       String   @id @db.VarChar(40)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Chat (M11). docs/plans/M11-chat.md §4. Private conversations now; rooms (M12) and group chats
// use the same tables, with their own kinds and columns added by their milestones.
// ---------------------------------------------------------------------------

enum ConversationKind {
  /// Two people. One conversation per pair.
  DIRECT
  /// A room the association opened: any active member can join (M12).
  ROOM
  /// A small group a member made; people are in it by invitation (M13).
  GROUP

  @@map("conversation_kind")
}

enum ConversationMemberRole {
  MEMBER
  /// Appointed by staff for one room (M12).
  MODERATOR
  /// The person who runs a group: at first the one who made it (M13).
  ADMIN

  @@map("conversation_member_role")
}

/// Who may invite a person to a group or a room by invitation (M13 plan §2.4).
enum ChatInviteAudience {
  /// Members who could write to me privately.
  LISTED
  /// Only people I already have a conversation or a group with.
  CONTACTS
  NOBODY

  @@map("chat_invite_audience")
}

enum ChatInvitationStatus {
  OPEN
  ACCEPTED
  DECLINED
  /// Taken back by whoever may invite there.
  WITHDRAWN
  EXPIRED

  @@map("chat_invitation_status")
}

/// Who may start a conversation with a person (M11 plan §3).
enum ChatAudience {
  /// Active members, while the person is listed in the member directory.
  LISTED
  NOBODY

  @@map("chat_audience")
}

enum ChatReportStatus {
  OPEN
  DISMISSED
  UPHELD

  @@map("chat_report_status")
}

/// What a reviewer did about a report.
enum ChatReportAction {
  NONE
  MESSAGE_DELETED
  SUSPENDED
  /// A reported room was archived (M12).
  ROOM_ARCHIVED

  @@map("chat_report_action")
}

/// A conversation. Messages are numbered inside it (last_seq), so their order, paging and the
/// unread count never depend on clocks. The pair columns hold the two people of a direct
/// conversation, smaller id first; a database check keeps the order and the unique index keeps
/// one conversation per pair.
model Conversation {
  id             String           @id @db.Uuid
  kind           ConversationKind @default(DIRECT)
  /// Whose it is. Empty: the platform's own. (M16)
  organisationId String?          @map("organisation_id") @db.Uuid
  userLowId      String?          @map("user_low_id") @db.Uuid
  userHighId     String?          @map("user_high_id") @db.Uuid
  /// The number of the newest message; the next message gets last_seq + 1 under a row lock.
  lastSeq        Int              @default(0) @map("last_seq")
  /// When the newest message was sent: the list shows the newest activity first.
  lastMessageAt  DateTime?        @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Rooms (M12). Empty for a direct conversation; a database check keeps it so. ---
  /// A room has a Hebrew name, unique among rooms, and may have an English one.
  nameHe         String?   @map("name_he") @db.VarChar(120)
  nameEn         String?   @map("name_en") @db.VarChar(120)
  descriptionHe  String?   @map("description_he") @db.VarChar(1000)
  descriptionEn  String?   @map("description_en") @db.VarChar(1000)
  categoryId     String?   @map("category_id") @db.Uuid
  /// A picture staff uploaded for the room.
  pictureFileId  String?   @map("picture_file_id") @db.Uuid
  /// An announcements room: only moderators write.
  moderatorsOnly Boolean   @default(false) @map("moderators_only")
  /// Locked by a moderator: nobody but moderators writes. With a time, until then.
  locked         Boolean   @default(false)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  /// An archived room leaves the lists and is read-only. Rooms are never deleted.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  /// Kept by the join and leave code, so the list of rooms never counts rows.
  memberCount    Int       @default(0) @map("member_count")
  /// A room by invitation: not listed, not found, joined only by accepting an invitation (M13).
  inviteOnly     Boolean   @default(false) @map("invite_only")

  userLow      User?                    @relation("ConversationUserLow", fields: [userLowId], references: [id], onDelete: SetNull)
  userHigh     User?                    @relation("ConversationUserHigh", fields: [userHighId], references: [id], onDelete: SetNull)
  category     ChatRoomCategory?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  picture      StoredFile?              @relation("RoomPicture", fields: [pictureFileId], references: [id], onDelete: SetNull)
  members      ConversationMember[]
  messages     Message[]
  reports      ChatReport[]
  pins         MessagePin[]
  bans         ConversationBan[]
  invitations  ConversationInvitation[]
  organisation Organisation?            @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@index([kind, archivedAt, lastMessageAt(sort: Desc)])
  @@index([categoryId])
  @@index([organisationId])
  @@map("conversations")
}

/// A person in a conversation, with what is theirs alone: how far they have read and received,
/// and whether they muted or archived it. Read and delivered are two numbers per person, not a
/// row per message.
model ConversationMember {
  conversationId   String                 @map("conversation_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  role             ConversationMemberRole @default(MEMBER)
  joinedAt         DateTime               @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// The number of the last message this person has read.
  lastReadSeq      Int                    @default(0) @map("last_read_seq")
  /// The number of the last message this person's app has received.
  lastDeliveredSeq Int                    @default(0) @map("last_delivered_seq")
  /// "Mark as unread": shown as unread until the person opens it again.
  markedUnread     Boolean                @default(false) @map("marked_unread")
  muted            Boolean                @default(false)
  /// When a timed mute ends; null with muted = true means until switched back.
  mutedUntil       DateTime?              @map("muted_until") @db.Timestamptz(6)
  archivedAt       DateTime?              @map("archived_at") @db.Timestamptz(6)
  /// Pinned to the top of this person's own list, newest pin first (M13). Five at most.
  pinnedAt         DateTime?              @map("pinned_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, archivedAt])
  @@index([userId, pinnedAt])
  @@index([conversationId, role])
  @@map("conversation_members")
}

/// A message. Plain text. Deleting for everyone erases the text and keeps the row, so the
/// conversation shows that something was there. A deleted account's messages stay for the other
/// person, without a sender.
model Message {
  id             String                   @id @db.Uuid
  conversationId String                   @map("conversation_id") @db.Uuid
  /// The message's number inside its conversation, from 1.
  seq            Int
  senderId       String?                  @map("sender_id") @db.Uuid
  body           String                   @db.VarChar(4000)
  replyToId      String?                  @map("reply_to_id") @db.Uuid
  /// From the Idempotency-Key header: a retried request never sends the message twice.
  idempotencyKey String?                  @map("idempotency_key") @db.VarChar(100)
  editedAt       DateTime?                @map("edited_at") @db.Timestamptz(6)
  deletedAt      DateTime?                @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Marked by a moderator: it stands out, and the room is told (M12).
  announcement   Boolean                  @default(false)
  /// Set when a moderator or staff deleted it, not its sender (M12).
  removedBy      String?                  @map("removed_by") @db.Uuid
  /// The people mentioned in it, all of them in the room when it was sent (M12).
  mentions       String[]                 @default([]) @db.Uuid
  /// A copy of a message from elsewhere; it doesn't say whose or from where (M13).
  forwarded      Boolean                  @default(false)
  /// Maintained by a trigger: the text after the Hebrew normalisation, as for news.
  searchVector   Unsupported("tsvector")? @map("search_vector")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")
  hides        MessageHide[]
  reports      ChatReport[]
  reactions    MessageReaction[]
  pins         MessagePin[]
  attachments  MessageAttachment[]

  @@unique([conversationId, seq])
  @@unique([senderId, idempotencyKey])
  @@index([replyToId])
  @@index([searchVector], map: "messages_search_idx", type: Gin)
  @@map("messages")
}

/// "Delete for me": a row only for a message a person hid from their own side.
model MessageHide {
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
  @@map("message_hides")
}

/// One person blocked another: neither can send to the other while the row exists.
model ChatBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("ChatBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("chat_blocks")
}

/// A person's chat settings. A missing row means the starting settings.
model ChatPreference {
  userId          String             @id @map("user_id") @db.Uuid
  audience        ChatAudience       @default(LISTED)
  /// Show others when I have read their messages (and see it for theirs).
  readReceipts    Boolean            @default(true) @map("read_receipts")
  /// Show others when I am typing.
  typing          Boolean            @default(true)
  /// When the last "messages are waiting" email went out: at most one a day.
  unreadEmailedAt DateTime?          @map("unread_emailed_at") @db.Timestamptz(6)
  /// Who may invite me to a group or a room by invitation (M13).
  invitesFrom     ChatInviteAudience @default(LISTED) @map("invites_from")
  /// Show the people I talk with when I am active (and see it for them) (M13).
  showActivity    Boolean            @default(true) @map("show_activity")
  /// When this person last had a chat page open; written at most once every ten minutes.
  lastActiveAt    DateTime?          @map("last_active_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_preferences")
}

/// The reasons a person can choose when reporting. Rows, not code, so they can be edited.
model ChatReportCategory {
  id        String  @id @db.Uuid
  key       String  @unique @db.VarChar(40)
  nameHe    String  @map("name_he") @db.VarChar(120)
  nameEn    String  @map("name_en") @db.VarChar(120)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  reports ChatReport[]

  @@map("chat_report_categories")
}

/// A report about a person or a message. The snapshot keeps the reported message and the few
/// around it as they were, so a later deletion doesn't empty the report; it is erased 90 days
/// after the report is closed.
model ChatReport {
  id             String           @id @db.Uuid
  reporterId     String?          @map("reporter_id") @db.Uuid
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  conversationId String?          @map("conversation_id") @db.Uuid
  messageId      String?          @map("message_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  description    String?          @db.VarChar(2000)
  snapshot       Json?
  status         ChatReportStatus @default(OPEN)
  action         ChatReportAction @default(NONE)
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  /// The reviewer's reason for the decision.
  resolution     String?          @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter     User?              @relation("ChatReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User?              @relation("ChatReported", fields: [reportedUserId], references: [id], onDelete: SetNull)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  category     ChatReportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([reportedUserId])
  @@index([reporterId])
  @@index([messageId])
  @@index([conversationId])
  @@map("chat_reports")
}

/// A person staff suspended from sending in chat. They can still read, and keep the rest of the
/// site. In force from starts_at until ends_at (null: until lifted), unless lifted.
model ChatSuspension {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  reason    String    @db.VarChar(1000)
  reportId  String?   @map("report_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  liftedAt  DateTime? @map("lifted_at") @db.Timestamptz(6)
  liftedBy  String?   @map("lifted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt(sort: Desc)])
  @@map("chat_suspensions")
}

// ---------------------------------------------------------------------------
// Chat rooms (M12). docs/plans/M12-chat-rooms.md §4. A room is a conversation of kind ROOM.
// ---------------------------------------------------------------------------

/// What rooms are grouped by on the "Browse rooms" screen. Staff edit them.
model ChatRoomCategory {
  id        String @id @db.Uuid
  key       String @unique @db.VarChar(40)
  nameHe    String @map("name_he") @db.VarChar(120)
  nameEn    String @map("name_en") @db.VarChar(120)
  sortOrder Int    @default(0) @map("sort_order")

  rooms Conversation[]

  @@map("chat_room_categories")
}

/// One of the fixed reactions a person put on a message. One of each kind per person.
model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reaction  String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, reaction])
  @@index([userId])
  @@map("message_reactions")
}

/// A message a moderator pinned to the top of a room. Five at most (a trigger).
model MessagePin {
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  pinnedBy       String   @map("pinned_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([conversationId, messageId])
  @@index([messageId])
  @@map("message_pins")
}

/// An invitation to a group or to a room by invitation. It gives nothing until it is accepted:
/// the invited person is not in the conversation and reads none of it. One open invitation per
/// person per conversation (a partial unique index).
model ConversationInvitation {
  id             String               @id @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  invitedBy      String?              @map("invited_by") @db.Uuid
  status         ChatInvitationStatus @default(OPEN)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(6)
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ChatInvited", fields: [userId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("ChatInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([conversationId, status])
  @@map("conversation_invitations")
}

/// A picture, a PDF or a video sent with a message (M13). A forwarded message points at the same
/// stored file, so a file is erased when its last attachment goes.
model MessageAttachment {
  messageId String @map("message_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  /// The order inside the message, from 0.
  position  Int    @db.SmallInt

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile @relation("MessageAttachment", fields: [fileId], references: [id], onDelete: Cascade)

  @@id([messageId, position])
  @@unique([messageId, fileId], map: "message_attachments_message_file_key")
  @@index([fileId])
  @@map("message_attachments")
}

/// A person banned from one room: they can't join it. In force from starts_at until ends_at
/// (null: until lifted), unless lifted.
model ConversationBan {
  id             String    @id @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  reason         String    @db.VarChar(1000)
  startsAt       DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(6)
  liftedAt       DateTime? @map("lifted_at") @db.Timestamptz(6)
  liftedBy       String?   @map("lifted_by") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, userId])
  @@index([userId])
  @@map("conversation_bans")
}

// ---------------------------------------------------------------------------
// Verifying physicians and medical students on the platform (M17).
// docs/plans/M17-verification-and-onboarding.md; organisations' applications are above.
// ---------------------------------------------------------------------------

/// What a verified person is known as. A mark is shown for RESIDENT and STUDENT.
enum VerifiedAs {
  SPECIALIST
  RESIDENT
  PHYSICIAN
  STUDENT

  @@map("verified_as")
}

/// PENDING → APPROVED or REJECTED (or WITHDRAWN by the person). An approved one ends as REVOKED
/// (by a reviewer) or EXPIRED (its date passed).
enum PhysicianVerificationState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  REVOKED
  EXPIRED

  @@map("physician_verification_state")
}

enum PhysicianDecision {
  APPROVE
  REJECT
  REVOKE

  @@map("physician_decision")
}

/// What the Ministry of Health's public register showed the reviewer.
enum RegisterStatus {
  ACTIVE_PERMANENT
  ACTIVE_TEMPORARY
  SUSPENDED
  NOT_FOUND

  @@map("register_status")
}

/// Israel's medical schools, for students (reference data).
model MedicalSchool {
  id     String  @id @db.Uuid
  /// Stable key the reference seed matches on (e.g. "tau").
  code   String  @unique @db.VarChar(64)
  nameHe String  @map("name_he") @db.VarChar(200)
  nameEn String  @map("name_en") @db.VarChar(200)
  active Boolean @default(true)

  verifications PhysicianVerification[]

  @@map("medical_schools")
}

/// A request to be verified by the platform. One open per person (partial unique index); a
/// licence number is in one open or approved request at most (partial unique index).
model PhysicianVerification {
  id                 String                     @id @db.Uuid
  userId             String                     @map("user_id") @db.Uuid
  kind               VerifiedAs
  state              PhysicianVerificationState @default(PENDING)
  /// The medical licence number, encrypted, and a keyed hash to compare. Never returned.
  licenceEnc         String?                    @map("licence_enc")
  licenceHash        String?                    @map("licence_hash") @db.VarChar(128)
  /// The specialist certificate number (specialists), the same way.
  certificateEnc     String?                    @map("certificate_enc")
  certificateHash    String?                    @map("certificate_hash") @db.VarChar(128)
  /// Students: the school, when they expect to graduate, and the school's confirmation until it
  /// is decided on.
  schoolId           String?                    @map("school_id") @db.Uuid
  expectedGraduation DateTime?                  @map("expected_graduation") @db.Date
  documentFileId     String?                    @unique @map("document_file_id") @db.Uuid
  /// What the person wants the reviewer to know, or their answer to a refusal.
  note               String?                    @db.VarChar(1000)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt           DateTime?                  @map("closed_at") @db.Timestamptz(6)
  /// When the person was told their approved verification ends soon (step 7).
  noticeSentAt       DateTime?                  @map("notice_sent_at") @db.Timestamptz(6)

  user      User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    MedicalSchool?                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  document  StoredFile?                     @relation(fields: [documentFileId], references: [id], onDelete: SetNull)
  decisions PhysicianVerificationDecision[]

  @@index([state, createdAt])
  @@index([userId])
  @@map("physician_verifications")
}

/// Who decided what, and on what the register showed. Kept when the document is deleted.
model PhysicianVerificationDecision {
  id                 String            @id @db.Uuid
  verificationId     String            @map("verification_id") @db.Uuid
  decision           PhysicianDecision
  decidedBy          String?           @map("decided_by") @db.Uuid
  reason             String?           @db.VarChar(1000)
  registerStatus     RegisterStatus?   @map("register_status")
  licenceMatches     Boolean?          @map("licence_matches")
  certificateMatches Boolean?          @map("certificate_matches")
  at                 DateTime          @default(now()) @db.Timestamptz(6)

  verification PhysicianVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, at])
  @@map("physician_verification_decisions")
}

/// A verified person invites a colleague to the platform by email (M17 step 6). It carries no
/// rights: it only brings them to the door. The address is kept as a keyed hash only, to know
/// when it joins and not to send twice.
model PlatformInvitation {
  id         String    @id @db.Uuid
  inviterId  String    @map("inviter_id") @db.Uuid
  emailHash  String    @map("email_hash") @db.VarChar(128)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When an account was made with the address.
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  inviter User @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
  @@index([emailHash])
  @@map("platform_invitations")
}
