# IUA Connect: environment template. Placeholders only; never put real secrets here.
# `pnpm setup:dev` copies this file to `.env` and replaces every __GENERATED__ value
# with a random local value. `.env` is git-ignored.

NODE_ENV=development

# --- API ---
API_PORT=4000
# Comma-separated list of browser origins allowed by CORS
WEB_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# --- PostgreSQL provisioning (used only by `pnpm setup:dev` / `pnpm db:provision`) ---
# A superuser connection used to create the roles and databases below.
PG_SUPERUSER_URL=postgresql://postgres@localhost:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iua_connect
DB_TEST_NAME=iua_connect_test
# Owner role: owns the schema, runs migrations.
DB_OWNER_USER=iua_owner
DB_OWNER_PASSWORD=__GENERATED__
# App role: used by the running API. Cannot UPDATE/DELETE/TRUNCATE audit_logs.
DB_APP_USER=iua_app
DB_APP_PASSWORD=__GENERATED__

# Connection strings (setup:dev fills these in from the values above)
DATABASE_URL=__GENERATED__
MIGRATION_DATABASE_URL=__GENERATED__
TEST_DATABASE_URL=__GENERATED__
TEST_MIGRATION_DATABASE_URL=__GENERATED__

# --- Adapters (ARCHITECTURE.md §5) ---
# Only the demo implementations exist so far. The API refuses to start with
# NODE_ENV=production while any demo adapter is selected.
STORAGE_ADAPTER=local
# Uploaded files (local adapter), relative to the repository root. Git-ignored.
STORAGE_DIR=storage
MAILER_ADAPTER=console
MALWARE_SCANNER=noop
RATE_LIMIT_STORE=memory
# Multiplies every rate limit. Leave at 1; only automated browser test runs raise it.
RATE_LIMIT_SCALE=1
# Background jobs (scheduled publishing, cleanup): pgboss, stored in PostgreSQL.
JOB_QUEUE=pgboss

# --- Identity (M1) ---
# Public origin of the web app (used in links sent by email).
APP_BASE_URL=http://localhost:3001
# The console mailer writes emails here (git-ignored), so the demo needs no mail server.
MAIL_OUTBOX_DIR=outbox
# Keys below are generated by setup:dev with a "dev-" key ID. The API refuses "dev-" keys in
# production; there they come from a secret manager.
# Ed25519 key pair for access tokens (base64-encoded PEM).
JWT_PRIVATE_KEY=__GENERATED__
JWT_PUBLIC_KEY=__GENERATED__
JWT_KEY_ID=__GENERATED__
# HMAC key for storing refresh/email tokens and recovery codes (base64, 32 bytes).
TOKEN_HASH_KEY=__GENERATED__
# AES-256-GCM keys for encrypted fields such as TOTP secrets: "<keyId>:<base64 32 bytes>[,...]".
FIELD_ENCRYPTION_KEYS=__GENERATED__
FIELD_ENCRYPTION_KEY_ID=__GENERATED__
