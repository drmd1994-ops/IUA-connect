{
  "name": "@medconnect/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "UI translations (he, en; ar and ru later) and locale metadata",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@medconnect/eslint-config": "workspace:*",
    "@medconnect/tsconfig": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.1"
  }
}
