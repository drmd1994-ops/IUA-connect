{
  "name": "@medconnect/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas, error codes, permission keys and helpers shared by the API and the web app",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./correlation": {
      "types": "./dist/correlation.d.ts",
      "default": "./dist/correlation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@medconnect/eslint-config": "workspace:*",
    "@medconnect/tsconfig": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
