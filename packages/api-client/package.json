{
  "name": "@medconnect/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client generated from the API's OpenAPI document, and the chat rules the site and the app share. Do not hand-write request types.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat-model.d.ts",
      "default": "./dist/chat-model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run"
  },
  "dependencies": {
    "@medconnect/shared": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@medconnect/eslint-config": "workspace:*",
    "@medconnect/tsconfig": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.1"
  }
}
