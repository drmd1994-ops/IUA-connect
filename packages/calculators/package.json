{
  "name": "@medconnect/calculators",
  "version": "0.0.0",
  "private": true,
  "description": "Clinical calculators shared by the site and the app (M30): definitions and pure functions, nothing stored",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@medconnect/eslint-config": "workspace:*",
    "@medconnect/tsconfig": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
